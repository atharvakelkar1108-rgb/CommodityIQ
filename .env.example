# Copy to backend/.env or project root .env and fill in if needed.
# All variables are optional — the app runs without them.

# Optional commodity API (see README)
# OMKAR_API_KEY=your_key_here

# Optional: faster Hugging Face downloads for FinBERT
# HF_TOKEN=your_hf_token_here

# Force keyword-only sentiment (skip FinBERT)
# DISABLE_FINBERT=0
